# Flask Configuration
FLASK_APP=blogg.py
# Generate a secure secret key via: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=your-secret-key-here

# Email Configuration (Flask-Mail)
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
BLOGG_ADMIN=admin@example.com

# Database Configuration (SQLAlchemy)
# Development SQLite database (persisted to disk)
DEV_DATABASE_URL=sqlite:///data-dev.sqlite

# Testing SQLite database (in-memory)
TEST_DATABASE_URL=sqlite://

# Production database URL
DATABASE_URL=sqlite:///data.sqlite
