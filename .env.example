# Flask Configuration
FLASK_APP=blogg.py
# Generate a secure secret key via: python -c "import secrets; print(secrets.token_hex(16))"
SECRET_KEY=your-secret-key-here

# Email Configuration (Flask-Mail)
MAIL_SERVER=smtp.googlemail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-email-app-password
BLOGG_ADMIN=admin@example.com

# Database Configuration (SQLAlchemy)
# Development SQLite database (persisted to disk)
DEV_DATABASE_URL=sqlite:///data-dev.sqlite

# Testing SQLite database (in-memory)
TEST_DATABASE_URL=sqlite://

# Production database URL
DATABASE_URL=sqlite:///data.sqlite

# ---------------------------------------------------------------------------
# IAM Configuration (all optional - sane defaults apply)
# ---------------------------------------------------------------------------
# Account lockout after N consecutive failed logins, for M minutes
BLOGG_MAX_FAILED_LOGINS=5
BLOGG_LOCKOUT_MINUTES=15
# Session timeouts (server-side, enforced via the sessions table)
BLOGG_SESSION_IDLE_MINUTES=60
BLOGG_SESSION_ABSOLUTE_HOURS=24
# API token TTLs in seconds (default 1h, max 30 days)
BLOGG_TOKEN_DEFAULT_TTL=3600
BLOGG_TOKEN_MAX_TTL=2592000
# Number of previous passwords that cannot be reused
BLOGG_PASSWORD_HISTORY_COUNT=5
# Password max age in days; 0 disables expiry (opt-in)
BLOGG_PASSWORD_MAX_AGE_DAYS=0
# TOTP issuer name shown in authenticator apps
BLOGG_MFA_ISSUER=Blogg
# Require MFA for Administrator accounts (true/false)
BLOGG_ENFORCE_MFA_FOR_ADMINS=false
# Login / MFA challenge rate limit (Flask-Limiter syntax)
BLOGG_LOGIN_RATE_LIMIT=5 per minute
# Rate-limit storage: memory:// (dev/test) or filesystem:// (production)
RATELIMIT_STORAGE_URI=memory://
